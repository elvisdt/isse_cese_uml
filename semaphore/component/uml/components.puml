' ============================================================
' Semáforo - Diagrama de componentes, construcción bottom-up
' Un solo archivo con 9 pasos. Cada @startuml genera un diagrama.
' Cada bloque muestra una breve descripción desde que aparece.
' Verde = componente o interfaz NUEVO en ese paso.
' Amarillo = componente existente que gana funciones (líneas con "+").
' Los LEDs siempre usan su propio color (rojo, amarillo y verde claros).
' El texto fuera de @startuml/@enduml es ignorado por PlantUML.
' NOTA: -up- / -down- son pistas de layout (Application arriba, HAL
' abajo). Los sockets se dibujan con la sintaxis  Cliente -( Interfaz.
' ============================================================



' PASO 1 - Componente dummy
' Partimos de una caja vacía que representa "el sistema" sin saber
' todavía qué hay adentro. Ya tiene una breve descripción, aunque
' todavía no tiene interfaces ni responsabilidades.
@startuml paso1_dummy
title Paso 1 - Componente dummy
component Dummy #palegreen [
  **Dummy**
  --
  Caja vacía
  sin responsabilidades todavía
]


@enduml


' PASO 2 - La capa más baja (HAL): LEDs y consola
' Empezamos desde abajo: los componentes que tocan el hardware.
' Cada LED PROVEE la interfaz ILed (ball) y la consola provee IConsole.
' Cada bloque muestra una breve descripción de lo que hace.
@startuml paso2_hal
title Paso 2 - Capa HAL
skinparam componentStyle uml2
skinparam packageStyle rectangle
package "HAL" {
  component LedR #FFC9C9 [
    **LedR**
    --
    Luz roja
    ledOn() / ledOff()
  ]
  component LedY #FFF3B0 [
    **LedY**
    --
    Luz amarilla
    ledOn() / ledOff()
  ]
  component LedG #C9F2C9 [
    **LedG**
    --
    Luz verde
    ledOn() / ledOff()
  ]
  component Console #palegreen [
    **Console**
    --
    Entrada y salida
    por terminal
    consoleGetKey(), print()
  ]
}
component Dummy [
  **Dummy**
  --
  Caja vacía
  sin responsabilidades todavía
]
() ILed #palegreen
() IConsole #palegreen

LedR -up- ILed
LedY -up- ILed
LedG -up- ILed
Console -up- IConsole

@enduml


' PASO 3 - Servicios: el temporizador
' Subimos una capa. Timer ofrece ITimer (arma y desarma eventos TOUT).
' Es el servicio de tiempo que usará la máquina de estados.
@startuml paso3_servicios
title Paso 3 - Capa de servicios (Timer)
skinparam componentStyle uml2
skinparam packageStyle rectangle
package "Services" {
  component Timer #palegreen [
    **Timer**
    --
    Servicio de tiempo
    Genera TOUT al vencer
    cada estado
  ]
}
package "HAL" {
  component LedR #FFC9C9 [
    **LedR**
    --
    Luz roja
    ledOn() / ledOff()
  ]
  component LedY #FFF3B0 [
    **LedY**
    --
    Luz amarilla
    ledOn() / ledOff()
  ]
  component LedG #C9F2C9 [
    **LedG**
    --
    Luz verde
    ledOn() / ledOff()
  ]
  component Console [
    **Console**
    --
    Entrada y salida
    por terminal
    consoleGetKey(), print()
  ]
}
component Dummy [
  **Dummy**
  --
  Caja vacía
  sin responsabilidades todavía
]
() ILed
() IConsole
() ITimer #palegreen

LedR -up- ILed
LedY -up- ILed
LedG -up- ILed
Console -up- IConsole
Timer -up- ITimer

@enduml


' PASO 4 - El dummy se convierte en Traffic
' El dummy se llena de sentido: es Traffic, la máquina de estados.
' REQUIERE ILed e ITimer (sockets -( ) y PROVEE ITrafficEvents para
' que otros le envíen eventos.
@startuml paso4_traffic
title Paso 4 - Dummy -> Traffic
skinparam componentStyle uml2
skinparam packageStyle rectangle
package "Application" {
  component Traffic #palegreen [
    **Traffic**
    --
    Máquina de estados
    R > YtoG > G > YtoR
    Atiende BUTTON y TOUT
    Enciende y apaga los LEDs
  ]
}
package "Services" {
  component Timer [
    **Timer**
    --
    Servicio de tiempo
    Genera TOUT al vencer
    cada estado
  ]
}
package "HAL" {
  component LedR #FFC9C9 [
    **LedR**
    --
    Luz roja
    ledOn() / ledOff()
  ]
  component LedY #FFF3B0 [
    **LedY**
    --
    Luz amarilla
    ledOn() / ledOff()
  ]
  component LedG #C9F2C9 [
    **LedG**
    --
    Luz verde
    ledOn() / ledOff()
  ]
  component Console [
    **Console**
    --
    Entrada y salida
    por terminal
    consoleGetKey(), print()
  ]
}
() ILed
() IConsole
() ITimer
() ITrafficEvents #palegreen

LedR -up- ILed
LedY -up- ILed
LedG -up- ILed
Console -up- IConsole
Timer -up- ITimer
Traffic -down- ITrafficEvents

Traffic -down-( ILed
Traffic -down-( ITimer
@enduml


