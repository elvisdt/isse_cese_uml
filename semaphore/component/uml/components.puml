    --
    Servicio de tiempo
    Genera TOUT al vencer
    cada estado
    + Tiempos configurables
  ]
  component Config #palegreen [
    **Config**
    --
    Tiempos por estado
    (rojo, amarillo, verde)
  ]
  component Logger #palegreen [
    **Logger**
    --
    Registra transiciones
    y eventos con nivel
  ]
}
package "HAL" {
